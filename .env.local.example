# Local development — copy to .env.local and fill with test values
# cp .env.local.example .env.local
# NEVER commit .env.local
#
# MongoDB: If using Atlas with user richyrichaii, use:
#   MONGODB_URI=mongodb+srv://richyrichaii:PASSWORD@YOUR_CLUSTER.mongodb.net/pvabazaar
#   Encode password: ! -> %21  so  pva123zxc!  ->  pva123zxc%21

MONGODB_URI=mongodb://localhost:27017/pvabazaar
# Or Atlas: MONGODB_URI=mongodb+srv://richyrichaii:pva123zxc%21@YOUR_CLUSTER.mongodb.net/pvabazaar

JWT_SECRET=dev_jwt_secret_min_32_characters_long
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Admin / primary user (app login: richyrichaii@pvabazaar.org with password pva123zxc!)
ADMIN_USERNAME=richyrichaii
ADMIN_PASSWORD=pva123zxc!
ADMIN_SECRET_CODE=dev_admin_secret

ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
ETHEREUM_RPC_URL=https://mainnet.base.org
