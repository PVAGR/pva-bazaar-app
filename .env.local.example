# Local development — copy to .env.local and fill with test values
# cp .env.local.example .env.local
# NEVER commit .env.local
#
# MongoDB: If using Atlas with user richyrichaii, use:
#   MONGODB_URI=mongodb+srv://richyrichaii:PASSWORD@YOUR_CLUSTER.mongodb.net/pvabazaar
#   Encode password: ! -> %21  so  pva123zxc!  ->  pva123zxc%21

MONGODB_URI=mongodb://localhost:27017/pvabazaar
# Or Atlas: MONGODB_URI=mongodb+srv://richyrichaii:pva123zxc%21@YOUR_CLUSTER.mongodb.net/pvabazaar

JWT_SECRET=dev_jwt_secret_min_32_characters_long
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Admin / primary user (app login: username richyrichaii, password pva123zxc!)
ADMIN_USERNAME=richyrichaii
ADMIN_PASSWORD=pva123zxc!
ADMIN_SECRET_CODE=dev_admin_secret
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Optional for local callback override:
# ADMIN_GITHUB_CALLBACK_URL=http://localhost:5001/api/admin/oauth/github/callback
# Optional custom frontend return:
# ADMIN_GITHUB_FRONTEND_URL=http://localhost:5173/#/admin
# Optional allowlist:
# ADMIN_GITHUB_ALLOWED_USERS=richyrichaii,richy@example.com,1234567

ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
ETHEREUM_RPC_URL=https://mainnet.base.org

# HeelKawn links
VITE_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
VITE_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
VITE_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1
NEXT_PUBLIC_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1
