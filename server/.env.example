# Phase 2+3 Artifact Registrar Server – Environment Variables

# ── Node ──────────────────────────────────────────────────────────
PORT=3001

# ── Blockchain (required only for minting) ────────────────────────
# JSON-RPC provider URL for the target network
# Base Sepolia (testnet):    https://sepolia.base.org
# Base Mainnet:              https://mainnet.base.org
RPC_URL=https://sepolia.base.org

# Private key of the account that owns the deployed ModernArtifact contract
# NEVER commit this file with a real key – keep it in .env (gitignored)
MINTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Address of your deployed ModernArtifact contract
CONTRACT_ADDRESS=

# Human-readable name shown in mint responses (e.g. base-sepolia)
NETWORK_NAME=base-sepolia

# ── IPFS (Pinata) ─────────────────────────────────────────────────────────────
# Get a free JWT at https://app.pinata.cloud/keys
# If not set, IPFS upload step returns 503; minting falls back to
# ipfs://pending/<uniqueHash> placeholder URI.
PINATA_JWT=

# ── Public URL (used inside IPFS metadata external_url field) ─────────────────
# In production set this to your deployed server URL.
SERVER_BASE_URL=https://api.pvabazaar.org

# ── Post-mint sync into main backend (optional) ───────────────────────────────
# Endpoint in backend/routes/items.js : POST /api/items/provenance/sync-mint
MAIN_APP_SYNC_URL=https://api.pvabazaar.org/api/items/provenance/sync-mint
MAIN_APP_SYNC_SECRET=

# ── Incoming webhook auth (optional but recommended) ───────────────────────────
# If set, /api/webhooks/* require this value in header:
#   X-Registrar-Webhook-Secret: <WEBHOOK_SHARED_SECRET>
WEBHOOK_SHARED_SECRET=
