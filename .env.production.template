# Production Environment Template
# Copy to .env.production and fill in your values

# ========== CORE ==========
NODE_ENV=production
PORT=5001

# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/pvabazaar?retryWrites=true&w=majority

# ========== AUTHENTICATION ==========
JWT_SECRET=your-super-secret-key-here-generate-with-openssl-rand-hex-32
JWT_EXPIRY=7d

# ========== BLOCKCHAIN ==========
ETHEREUM_RPC_URL=https://polygon-amoy-rpc.publicnode.com
ETHEREUM_CHAIN_ID=80002
ETHEREUM_CONTRACT_ADDRESS=0x...your-contract-address

# ========== PAYMENTS (Stripe) ==========
STRIPE_SECRET_KEY=sk_test_...your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_...your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_...your-publishable-key

# ========== EMAIL (SendGrid) ==========
SENDGRID_API_KEY=SG....your-sendgrid-api-key
SENDGRID_FROM=hello@pvabazaar.org
SENDGRID_FROM_NAME=PVA Bazaar

# ========== STORAGE (AWS S3 - Optional) ==========
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=pva-bazaar-uploads

# ========== CACHING (Redis - Optional) ==========
REDIS_URL=redis://:password@localhost:6379/0

# ========== SECURITY & MONITORING ==========
SENTRY_DSN=https://...your-sentry-dsn
API_RATE_LIMIT=100  # requests per 15 minutes
CORS_ORIGIN=https://your-frontend-url.com

# ========== EXTERNAL APIs ==========
IPFS_API_URL=https://api.pinata.cloud
PINATA_JWT=your-pinata-jwt-token

# ========== DEPLOYMENT PLATFORM ==========
# For Railway:
RAILWAY_SERVICE_NAME=pva-bazaar-api
RAILWAY_ENVIRONMENT_NAME=production

# For Render:
RENDER_SERVICE_ID=your-render-service-id

# For Fly.io:
FLY_APP_NAME=pva-bazaar

# ========== FEATURE FLAGS ==========
ENABLE_BLOCKCHAIN=true
ENABLE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_CACHING=true
ENABLE_MONITORING=true

# ========== ADMIN CONFIG ==========
ADMIN_EMAIL=admin@pvabazaar.org
SUPPORT_EMAIL=support@pvabazaar.org

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_FORMAT=json
