{
  "name": "pva-bazaar",
  "version": "1.0.0",
  "description": "PVA Bazaar - Sacred Marketplace for Authentic Artifacts",
  "private": true,
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node start.js",
    "dev": "turbo run dev --parallel",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd Frontend && npm run dev",
    "dev:web": "npm run dev -w pva-bazaar-web",
    "build": "node -e \"console.log('skip build on vercel')\"",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd Frontend && npm run build",
    "build:web": "npm run build -w pva-bazaar-web",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:staged": "vitest related --run",
    "test:smoke": "npm run smoke:openclaw --workspace backend",
    "test:phases-6-8": "vitest backend/__tests__/phases-6-8.test.js",
    "seed:db": "node backend/scripts/seedDatabase.js",
    "monitor:prod": "node backend/scripts/monitor-production.js",
    "deploy:verify": "bash backend/scripts/deploy-verify.sh",
    "verify:prod": "node scripts/verify-prod.mjs",
    "verify:prod:wait": "node scripts/wait-prod-deploy.mjs",
    "verify:live": "node scripts/verify-live-ready.mjs",
    "verify:routes:live": "node scripts/verify-frontend-routes-live.mjs",
    "verify:network": "node scripts/verify-backend-network.mjs",
    "verify:surface": "node scripts/verify-feature-surface.mjs",
    "verify:seo": "node scripts/verify-seo-surface.mjs",
    "verify:heelkawn:env": "node scripts/verify-heelkawn-env.mjs",
    "verify:connectivity": "npm run verify:network && npm run verify:live && npm run verify:surface && npm run verify:seo",
    "verify:network:wait": "node scripts/wait-verify-network.mjs",
    "verify:live:decentralized": "node scripts/verify-live-decentralized.mjs",
    "verify:live:admin": "node -e \"process.env.REQUIRE_ADMIN='true'; import('./scripts/verify-live-ready.mjs')\"",
    "verify:live:strict": "node -e \"process.env.STRICT='true'; import('./scripts/verify-live-ready.mjs').catch(e=>{console.error(e);process.exit(1);})\"",
    "data:onet:download": "powershell -ExecutionPolicy Bypass -File \"scripts/download-onet-jobs-skills.ps1\"",
    "e2e": "playwright test",
    "e2e:smoke:live": "playwright test --config=playwright.smoke-live.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:heelkawn": "eslint Frontend/src/pages/HeelKawnPage.jsx Frontend/src/pages/DownloadAppPage.jsx apps/pva-bazaar-web/src/app/heelkawn/page.tsx",
    "check:heelkawn": "npm run verify:heelkawn:env && npm run lint:heelkawn",
    "typecheck:frontend": "tsc --noEmit -p Frontend/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/pva-bazaar-web/tsconfig.json",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"const fs=require('fs');const cp=require('child_process');if(fs.existsSync('.git')){try{cp.execSync('husky install',{stdio:'inherit'})}catch(e){console.warn('husky install skipped')}}\"",
    "qa:full": "./qa/scripts/orchestrator.sh full",
    "qa:quick": "./qa/scripts/orchestrator.sh quick",
    "qa:performance": "./qa/scripts/orchestrator.sh performance",
    "qa:security": "./qa/scripts/orchestrator.sh security",
    "qa:accessibility": "./qa/scripts/orchestrator.sh accessibility",
    "qa:visual": "./qa/scripts/orchestrator.sh visual",
    "qa:backstop:test": "backstop test --config=qa/backstop.config.js",
    "qa:backstop:approve": "backstop approve --config=qa/backstop.config.js",
    "qa:lighthouse": "lhci autorun --config=qa/lighthouse/lhci.json",
    "qa:axe": "node qa/axe/axe-runner.js",
    "qa:pa11y": "pa11y-ci --config qa/pa11y/pa11y.ci.json",
    "qa:artillery": "artillery run qa/artillery/load-test.yml",
    "qa:brand:check": "node qa/scripts/check-brand-tokens.js",
    "qa:brand:check:staged": "git diff --cached --name-only '*.css' '*.scss' | xargs -I {} node qa/scripts/check-brand-tokens.js {}",
    "qa:secrets:scan": "gitleaks detect --source . --verbose",
    "clean": "rm -rf node_modules dist build out .next coverage qa/reports",
    "clean:full": "npm run clean && rm -f pnpm-lock.yaml && rm -f package-lock.json && npm install",
    "setup": "npm install && npm run prepare && npm run build",
    "ship": "turbo run lint typecheck test build",
    "health": "bash api-health-check.sh http://localhost:5001",
    "db:check": "node backend/scripts/connect-check.js",
    "db:seed": "node backend/seed.js",
    "contracts:compile": "npm --prefix contracts run compile",
    "contracts:node": "npm --prefix contracts run node",
    "contracts:deploy:local": "npm --prefix contracts run deploy:local",
    "contracts:deploy:amoy": "npm --prefix contracts run deploy:amoy",
    "contracts:deploy:sepolia": "npm --prefix contracts run deploy:sepolia",
    "contracts:deploy:polygon": "npm --prefix contracts run deploy:polygon",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:production:dry": "node scripts/deploy-production.mjs --dry-run",
    "deploy:railway": "bash scripts/deploy-railway.sh",
    "deploy:render": "bash scripts/deploy-render.sh",
    "deploy:flyio": "bash scripts/deploy-flyio.sh",
    "docker:build": "docker build -t pva-bazaar:latest .",
    "docker:run": "docker run -p 5001:5001 --env-file .env.production pva-bazaar:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@pinata/sdk": "^2.1.0",
    "@sentry/node": "^7.100.0",
    "@sentry/tracing": "^7.100.0",
    "@solana/web3.js": "^0.0.3",
    "@testing-library/dom": "^10.4.1",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "chromadb": "^3.0.14",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "depd": "^2.0.0",
    "dotenv": "^17.2.2",
    "eslint-config-next": "16.2.10",
    "ethers": "^6.16.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "next": "16.2.10",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.3",
    "nodemailer": "^9.0.3",
    "parseuri": "^3.0.2",
    "pdfkit": "^0.19.1",
    "postcss": "^8.5.10",
    "qs": "^6.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "redis": "^5.11.0",
    "rehype-sanitize": "^6.0.0",
    "serverless-http": "^3.2.0",
    "slugify": "^1.6.6",
    "stripe": "^14.10.0",
    "tmp": "^0.2.7",
    "tough-cookie": "^4.1.3",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1",
    "web3": "^4.16.0",
    "ws": "^8.20.1",
    "yaml": "^2.8.3",
    "yargs-parser": "^13.1.2",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@eslint/js": "^9.0.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "backstopjs": "^6.2.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.10",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.57.0",
    "prettier": "^3.1.0",
    "sort-package-json": "^2.6.0",
    "supertest": "^7.2.2",
    "turbo": "^2.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend",
    "Frontend"
  ],
  "keywords": [
    "marketplace",
    "nft",
    "blockchain",
    "artifacts",
    "provenance",
    "pva",
    "authentication"
  ],
  "author": "PVA Team",
  "license": "UNLICENSED"
}
