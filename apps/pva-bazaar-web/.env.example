# Base URL of the backend API (e.g. https://your-api.vercel.app).
# When set, the Verification page can look up artifact verification via GET /api/verification/artifact/:idOrSlug
NEXT_PUBLIC_VERIFICATION_API_URL=
# HeelKawn public links
NEXT_PUBLIC_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1
# Alternative: generic API base used by verification and future endpoints
# NEXT_PUBLIC_API_URL=

# Etsy shop URL (e.g. https://www.etsy.com/shop/YourShop). When set, the Archive page shows a "Shop on Etsy" link.
# NEXT_PUBLIC_ETSY_SHOP_URL=

# Canonical site URL for sitemap.xml (e.g. https://sanctuary.pvabazaar.org). Falls back to VERCEL_URL or https://pvabazaar.org.
# NEXT_PUBLIC_SITE_URL=

# Optional social image absolute URL override (if you host custom OG image asset).
# NEXT_PUBLIC_OG_IMAGE_URL=
