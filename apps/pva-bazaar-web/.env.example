# Backend API base URL (no trailing slash, no /api suffix). Used by verification, dashboard, deals, seller pages, conference.
# When unset, proxied via next.config.mjs rewrites (works when deployed on same origin).
NEXT_PUBLIC_API_URL=https://pva-backend-api.vercel.app

# Alternative: separate URL for verification lookups only (falls back to NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_VERIFICATION_API_URL=

# Etsy shop URL. When set, Archive and Cart pages show a "Shop on Etsy" link.
# NEXT_PUBLIC_ETSY_SHOP_URL=https://www.etsy.com/shop/YourShop

# Canonical site URL for sitemap.xml and robots.txt. Falls back to VERCEL_URL or https://pvabazaar.org.
NEXT_PUBLIC_SITE_URL=https://sanctuary.pvabazaar.org

# Optional social image absolute URL override (if you host custom OG image asset).
# NEXT_PUBLIC_OG_IMAGE_URL=

# HeelKawn public links
NEXT_PUBLIC_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1

# Main app registration destination for the Get Started page (defaults to https://pvabazaar.org/#/register).
# NEXT_PUBLIC_MAIN_APP_REGISTER_URL=https://pvabazaar.org/#/register

# Cloudinary cover uploads for the book publish flow. Overrides the built-in defaults.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dljrsobks
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=pva_books_covers
