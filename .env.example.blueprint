# Environment Variables Template for Blueprint v1

# ============================================
# Backend Environment Configuration
# ============================================

# Database (MongoDB Atlas - Free Tier Available)
# Get from: https://mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pvabazaar?retryWrites=true&w=majority

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-64-character-string-here

# Admin Code (for admin dashboard access)
ADMIN_SECRET_CODE=your-admin-secret-code

# ============================================
# IPFS Storage (Pinata - Free Tier: 1GB)
# ============================================
# Get from: https://pinata.cloud → API Keys
PINATA_API_KEY=your-pinata-api-key-here
PINATA_API_SECRET=your-pinata-secret-api-key-here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Alternative IPFS Providers (Optional)
# WEB3_STORAGE_TOKEN=your-web3-storage-token
# IPFS_NODE_URL=http://localhost:5001

# ============================================
# Livestreaming Platforms (Optional)
# ============================================

# Twitch Integration
# Get from: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_WEBHOOK_SECRET=your-webhook-secret-for-eventsub

# Livepeer (Decentralized Streaming)
# Get from: https://livepeer.studio/dashboard/developers/api-keys
LIVEPEER_API_KEY=your-livepeer-api-key

# Kick (Community API - if available)
# KICK_API_KEY=your-kick-api-key

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5001

# CORS (comma-separated origins)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================
# Optional Services
# ============================================

# Sentry Error Tracking (Optional)
# SENTRY_DSN=your-sentry-dsn
# SENTRY_ENVIRONMENT=development

# Stripe (if using e-commerce features)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Frontend Environment Configuration
# (Frontend/.env.development)
# ============================================

# API Base URL (points to backend)
VITE_API_URL=http://localhost:5001/api

# Cloudinary (if using image uploads)
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================
# Production Environment
# (Frontend/.env.production)
# ============================================

# VITE_API_URL=https://your-backend.vercel.app/api
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================
# Notes
# ============================================
# - Never commit .env files to git (already in .gitignore)
# - For Vercel deployment, set these in Vercel Dashboard → Settings → Environment Variables
# - For GitHub Pages, set VITE_* vars in GitHub Secrets → Actions
# - Rotate secrets regularly for security
# - Free tiers available for all services (MongoDB, Pinata, Livepeer)
