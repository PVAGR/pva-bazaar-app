{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.polygonscan.com https://*.infura.io; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.pvabazaar.org https://rpc-amoy.polygon.technology https://federation.pvabazaar.org; img-src 'self' data: https:; font-src 'self' data:;" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "builds": [
    {
      "src": "api/[...path].js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "backend/**"
      }
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "src": "^/writings/akashic-records(?:\\.html)?/?$", "status": 308, "dest": "/writings/pva-archive.html" },
    { "src": "^/writings/?$", "status": 308, "dest": "/#/library" },
    { "src": "^/writings/([^/.]+)/?$", "status": 308, "dest": "/writings/$1.html" },
    { "src": "^/pages/(?:admin|pvadashboard)\\.html$", "status": 308, "dest": "/#/admin" },
    { "src": "^/pages/(?:portfolio|productshowcase|market|pvashares|assetcreate|checkoutmint|artifact|provenance|provtrack|provtracker)\\.html$", "status": 308, "dest": "/#/marketplace" },
    { "src": "^/pages/(?:home|welcome|contact)\\.html$", "status": 308, "dest": "/" },
    { "src": "^/pages/.*\\.html$", "status": 308, "dest": "/#/library" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/Frontend/dist/index.html" }
  ]
}
