{
  "version": 2,
  "buildCommand": "cd apps/web-org && npm install && npm run build",
  "outputDirectory": "apps/web-org/dist",
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "engine": "no-turbo",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}