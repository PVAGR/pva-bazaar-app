{
  "version": 2,
  "buildCommand": "echo 'Serving static files from frontend folder'",
  "outputDirectory": "frontend",
  "installCommand": "echo 'No install needed'",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}