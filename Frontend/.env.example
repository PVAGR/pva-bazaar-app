# Frontend production environment variables
# Vite only exposes keys prefixed with VITE_

VITE_API_URL=https://api.yourdomain.com/api

# External form endpoint for public creator submissions (e.g., Formspree)
# Example: https://formspree.io/f/xxxxabcd
VITE_CREATOR_FORM_ACTION=
VITE_BACKEND_URL=https://api.yourdomain.com
VITE_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
VITE_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
VITE_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1
VITE_CONTRACT_ADDRESS=0xYourProductionContractAddress
VITE_GOVERNANCE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
VITE_TREASURY_CONTRACT_ADDRESS=0xYourTreasuryContractAddress
VITE_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
VITE_PILOT_MODE=true
VITE_DEFAULT_LANG=sw
VITE_PROOF_OF_PERSONHOOD_ENABLED=true
VITE_OFFLINE_SYNC_ENABLED=true
VITE_FEDERATION_ENABLED=false
VITE_FEDERATION_HUB_URL=https://federation.pvabazaar.org
VITE_COMMUNITY_ID=pvabazaar-kenya-pilot

# Production Readiness
VITE_TELEMETRY_URL=https://your-analytics-endpoint/collect
VITE_ADMIN_WALLET=0xYourAdminAddress
NODE_ENV=production
