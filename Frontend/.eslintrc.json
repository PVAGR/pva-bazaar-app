{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-console": ["warn", {
      "allow": ["warn", "error"]
    }]
  },
  "overrides": [
    {
      "files": ["src/lib/logger.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
