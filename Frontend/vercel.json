{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/index.html$", "status": 308, "dest": "/" },
    { "src": "^/home/?$", "status": 308, "dest": "/" },
    { "src": "^/status/?$", "status": 308, "dest": "/status.html" },
    { "src": "^/blogs/?$", "status": 308, "dest": "/public/blogs.html" },
    { "src": "^/new-post/?$", "status": 308, "dest": "/public/new-post.html" },
    { "src": "^/blog/?$", "status": 308, "dest": "/public/blogs.html" },
    { "src": "^/posts/?$", "status": 308, "dest": "/public/blogs.html" },
    { "src": "^/com/?$", "status": 308, "dest": "/market/" },
    { "src": "^/com/(.*)", "status": 308, "dest": "/market/$1" },
    { "src": "^/web-com/?$", "status": 308, "dest": "/market/" },
    { "src": "^/web-com/(.*)", "status": 308, "dest": "/market/$1" },
    { "src": "^/marketplace/?$", "status": 308, "dest": "/market/" },
    { "src": "^/marketplace/(.*)", "status": 308, "dest": "/market/$1" },
    { "src": "^/shop/?$", "status": 308, "dest": "/market/" },
    { "src": "^/shop/(.*)", "status": 308, "dest": "/market/$1" },
    { "src": "^/store/?$", "status": 308, "dest": "/market/" },
    { "src": "^/store/(.*)", "status": 308, "dest": "/market/$1" },
    { "src": "^/web-org/?$", "status": 308, "dest": "/org/" },
    { "src": "^/web-org/(.*)", "status": 308, "dest": "/org/$1" },
    { "src": "^/org/writings$", "status": 308, "dest": "/org/writings/" },
    { "src": "^/writings/?$", "status": 308, "dest": "/org/writings/" },
    { "src": "^/writing/?$", "status": 308, "dest": "/org/writings/" },
    { "src": "^/archive/?$", "status": 308, "dest": "/org/writings/" },
    { "src": "^/archives/?$", "status": 308, "dest": "/org/writings/" },
    { "src": "^/(writings|writing|archive|archives)/(.*)", "status": 308, "dest": "/org/writings/" },
    { "src": "^/novel/?$", "dest": "/dist/novel/index.html" },
    { "src": "^/biography/?$", "dest": "/dist/biography/index.html" },
    { "src": "^/research/?$", "dest": "/dist/research/index.html" },
    { "src": "^/market/?$", "dest": "/dist/public/market/index.html" },
    { "src": "^/market/(.*)", "dest": "/dist/public/market/$1" },
    { "src": "^/org/?$", "dest": "/dist/public/org/index.html" },
    { "src": "^/org/(.*)", "dest": "/dist/public/org/$1" },
    { "src": "^/api/blogs/quick-publish$", "dest": "api/blogs/quick-publish.js" },
    { "src": "^/api/blogs/([^/]+)$", "dest": "api/blogs/[slug].js" },
    { "src": "^/api/comments/([^/]+)/add$", "dest": "api/comments/[slug]/add.js" },
    { "src": "^/api/comments/([^/]+)$", "dest": "api/comments/[slug]/index.js" },
    { "src": "^/api/(.*)", "dest": "api/$1" },
    { "src": "^/(.*)", "dest": "/dist/$1" }
  ]
}
