# Production API URL - Your deployed backend
VITE_API_URL=https://api.pvabazaar.org/api

# Cloudinary (placeholders - fill later)
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME_HERE
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_UNSIGNED_UPLOAD_PRESET_HERE

# Federation metadata defaults used by index.html placeholders
VITE_FEDERATION_ENABLED=false
VITE_COMMUNITY_ID=pvabazaar-kenya-pilot
VITE_FEDERATION_HUB_URL=https://federation.pvabazaar.org

# Admin panel connection status stale threshold (milliseconds)
# Default: 120000 (2 minutes). Minimum: 15000 (15 seconds).
# VITE_STATUS_STALE_MS=120000
