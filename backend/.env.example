# Backend Environment Variables Template
# Copy this file to .env and fill in your real values
# For Vercel deployment, set these in the Vercel dashboard

# Port (not needed on Vercel serverless, but useful for local development)
PORT=5001

# Environment
NODE_ENV=production

# Database (REQUIRED for production)
MONGODB_URI=<your-production-database-url>

# Security (REQUIRED)
JWT_SECRET=<strong-secret-key-minimum-32-characters>

# Admin Login Credentials (REQUIRED for admin panel access)
ADMIN_USERNAME=<your-admin-username>
ADMIN_PASSWORD=<your-admin-password>

# Blockchain
ETHEREUM_RPC_URL=https://mainnet.base.org
ADMIN_WALLET_PUBLIC=0x463ace850a958e768618361e352fe9efe31d5d0e

# CORS (set to your GitHub Pages domain)
ALLOWED_ORIGIN=https://pvabazaar.org

# Feature flags
USE_MEMORY_DB=false
USE_VECTOR_DB=false
DEV_AUTO_SEED=false

# Set to 'true' to enable legacy marketplace endpoints (default: false)
LEGACY_MODE=false

# OpenClaw bridge (optional)
# Base URL of your OpenClaw gateway, for example: https://openclaw.yourdomain.com
OPENCLAW_GATEWAY_URL=
# OpenClaw outbound webhook URL that receives PVA Bazaar dispatch events
OPENCLAW_WEBHOOK_URL=
# Optional explicit health URL (defaults to ${OPENCLAW_GATEWAY_URL}/health)
OPENCLAW_HEALTH_URL=
# Optional bearer token used when calling OpenClaw
OPENCLAW_API_KEY=
# Optional shared secret required for POST /api/openclaw/dispatch via X-OpenClaw-Secret header
OPENCLAW_BRIDGE_SECRET=
