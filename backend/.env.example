# Backend Environment Variables Template
# Copy this file to .env and fill in your real values.
# For Vercel: set these in Project → Settings → Environment Variables (Production).
# Names below match production config for pvabazaar.org.

# Port (local dev only; Vercel ignores)
PORT=5001

# Environment
NODE_ENV=production

# Database (REQUIRED)
MONGODB_URI=<your-mongodb-connection-string>

# Authentication (REQUIRED)
JWT_SECRET=<min-32-chars-strong-secret>

# Admin (REQUIRED for admin dashboard)
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD=<admin-password>
ADMIN_SECRET_CODE=<admin-secret-code>

# Site & CORS
PUBLIC_SITE_URL=https://pvabazaar.org
ALLOWED_ORIGIN=https://pvabazaar.org

# Stripe (REQUIRED for checkout + fulfillment)
STRIPE_SECRET_KEY=sk_live_...
# REQUIRED after creating webhook in Stripe Dashboard (Developers → Webhooks):
STRIPE_WEBHOOK_SECRET=whsec_...

# Blockchain
ETHEREUM_RPC_URL=https://mainnet.base.org

# Feature flags
USE_MEMORY_DB=false
USE_VECTOR_DB=false
DEV_AUTO_SEED=false
LEGACY_MODE=false

# Email (optional; for fulfillment confirmation and payment-failed emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: verification API (for CI posting results to badge)
# VERIFY_API_SECRET=

# OpenAI (for Oracle Assessments)
# OPENAI_API_KEY=
