# Backend Environment Variables Template
# Copy this file to .env and fill in your real values
# For Vercel deployment, set these in the Vercel dashboard

# Port (not needed on Vercel serverless, but useful for local development)
PORT=5001

# Environment
NODE_ENV=production

# Database (REQUIRED for production)
MONGODB_URI=<your-production-database-url>

# Security (REQUIRED)
JWT_SECRET=<strong-secret-key-minimum-32-characters>

# Admin Login Credentials (REQUIRED for admin panel access)
ADMIN_USERNAME=<your-admin-username>
ADMIN_PASSWORD=<your-admin-password>

# Blockchain
ETHEREUM_RPC_URL=https://mainnet.base.org
ADMIN_WALLET_PUBLIC=0x463ace850a958e768618361e352fe9efe31d5d0e

# Solana payout rituals (optional; devnet by default)
SOLANA_CLUSTER=devnet
# Destination wallet for ritual payouts (Phantom / Solana address)
SOLANA_TREASURY_WALLET=

# CORS (set to your GitHub Pages domain)
ALLOWED_ORIGIN=https://pvabazaar.org

# Feature flags
USE_MEMORY_DB=false
USE_VECTOR_DB=false
DEV_AUTO_SEED=false

# Set to 'true' to enable legacy marketplace endpoints (default: false)
LEGACY_MODE=false

# OpenClaw bridge (optional)
# Base URL of your OpenClaw gateway, for example: https://openclaw.yourdomain.com
OPENCLAW_GATEWAY_URL=
# OpenClaw outbound webhook URL that receives PVA Bazaar dispatch events
OPENCLAW_WEBHOOK_URL=
# Optional explicit health URL (defaults to ${OPENCLAW_GATEWAY_URL}/health)
OPENCLAW_HEALTH_URL=
# Optional bearer token used when calling OpenClaw
OPENCLAW_API_KEY=
# Optional shared secret required for POST /api/openclaw/dispatch via X-OpenClaw-Secret header
OPENCLAW_BRIDGE_SECRET=

# Marketplace syndication connectors (optional)
# Configure webhook endpoints if you want automatic listing dispatch
# during item registration/retry to external channels.
FACEBOOK_MARKETPLACE_WEBHOOK_URL=
FACEBOOK_MARKETPLACE_WEBHOOK_TOKEN=
ETSY_LISTING_WEBHOOK_URL=
ETSY_LISTING_WEBHOOK_TOKEN=
EBAY_LISTING_WEBHOOK_URL=
EBAY_LISTING_WEBHOOK_TOKEN=

# Cloud Storage Providers (optional - configure the ones you want to use)
# Cloudinary (for images/videos with CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pinata IPFS (for decentralized storage)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# AWS S3 (for scalable cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Google Cloud Storage (optional)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_KEY_FILE=
