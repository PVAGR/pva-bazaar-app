# Backend Environment Variables Template
# Copy this file to .env and fill in your real values
# For Vercel deployment, set these in the Vercel dashboard

# Port (not needed on Vercel serverless, but useful for local development)
PORT=5001

# Environment
NODE_ENV=production

# Database (REQUIRED for production)
MONGODB_URI=<your-production-database-url>

# Security (REQUIRED)
JWT_SECRET=<strong-secret-key-minimum-32-characters>
ADMIN_SECRET_CODE=<your-admin-login-secret>
ADMIN_USERNAME=<your-admin-username>
ADMIN_PASSWORD=<your-admin-password>

# Blockchain
ETHEREUM_RPC_URL=https://mainnet.base.org
ADMIN_WALLET_PUBLIC=0x463ace850a958e768618361e352fe9efe31d5d0e

# ERC-20 Token Creator (optional)
# TOKEN_DEPLOYER_PRIVATE_KEY=0x...  # Wallet with ETH for gas
# ERC20_DEPLOY_BYTECODE=0x...       # Run: node backend/scripts/compile-erc20.js

# CORS (set to your GitHub Pages domain)
ALLOWED_ORIGIN=https://pvabazaar.org

# Feature flags
USE_MEMORY_DB=false
USE_VECTOR_DB=false
DEV_AUTO_SEED=false

# Set to 'true' to enable legacy marketplace endpoints (default: false)
LEGACY_MODE=false

# Email Configuration (for Phase 2 - Item Registration notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=consign@pvabazaar.org
SMTP_PASS=your-app-password-here

# AI API (Oracle Assessments + Richard AI chat)
# Prefer DeepSeek (cost-effective, OpenAI-compatible) or OpenAI
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Optional: DeepSeek model (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Alternative: OpenAI (used if DEEPSEEK_API_KEY not set)
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: OpenAI model for Richard AI (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
