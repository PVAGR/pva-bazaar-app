# Backend environment example (do not commit real secrets)
# Copy to backend/.env and customize for your environment

# Server
PORT=5000
NODE_ENV=development

# Database
# For local dev using Docker or local MongoDB
# MONGODB_URI=mongodb://localhost:27017/pvabazaar
# Or leave unset and USE_MEMORY_DB=true for in-memory dev DB
USE_MEMORY_DB=true

# Auth
JWT_SECRET=change_me_dev_secret
ADMIN_SECRET_CODE=change_me_admin_secret

# CORS
ALLOWED_ORIGIN=http://localhost:3000
# Alternatively allow all origins in dev (not recommended for prod)
# ALLOW_ALL_ORIGINS=true

# Dev helpers
DEV_AUTO_SEED=true

# Optional blockchain settings
ETHEREUM_RPC_URL=https://mainnet.base.org
ADMIN_WALLET_PUBLIC=0x0000000000000000000000000000000000000000

# Feature flags
# Enable unauthenticated quick-publish only in dev
ENABLE_QUICK_PUBLISH=true
