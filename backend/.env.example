# Backend Environment Variables Template
# Copy this file to .env and fill in your real values
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority&appName=Cluster0
USE_MEMORY_DB=false
JWT_SECRET=your_strong_jwt_secret_here_min_32_chars
ETHEREUM_RPC_URL=https://mainnet.base.org
ADMIN_WALLET_PUBLIC=0xYourAdminWalletPublicKeyHere
ALLOWED_ORIGIN=http://localhost:3000
DEV_AUTO_SEED=true
ADMIN_SECRET_CODE=your_secure_admin_code_here
USE_VECTOR_DB=false
