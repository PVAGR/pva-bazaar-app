{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "USE_MEMORY_DB": "true",
    "ENABLE_QUICK_PUBLISH": "true",
    "ALLOW_ALL_ORIGINS": "true",
    "ALLOWED_ORIGIN": "https://www.pvabazaar.org"
  }
}