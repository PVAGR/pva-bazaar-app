{
  "version": 2,
  "builds": [
    {
      "src": "api/ping.js",
      "use": "@vercel/node"
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/ping",
      "dest": "api/ping.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "USE_MEMORY_DB": "false",
    "ALLOWED_ORIGIN": "https://pvabazaar.org"
  }
}
