{
  "name": "pva-bazaar",
  "version": "1.0.0",
  "description": "PVA Bazaar - Blockchain-powered artisan marketplace",
  "main": "api/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node api/index.js",
    "dev": "nodemon api/index.js",
    "openclaw:worker": "node scripts/openclaw-queue-worker.js",
    "openclaw:worker:dev": "nodemon scripts/openclaw-queue-worker.js",
    "openclaw:worker:once": "node -e \"process.env.OPENCLAW_WORKER_RUN_ONCE='true'; require('./scripts/openclaw-queue-worker.js');\"",
    "openclaw:workers": "node scripts/openclaw-multi-worker.js",
    "openclaw:workers:5": "node -e \"process.env.OPENCLAW_WORKER_COUNT='5'; require('./scripts/openclaw-multi-worker.js');\"",
    "deals:outbound-worker": "node scripts/deal-outbound-dispatch-worker.js",
    "deals:outbound-worker:dev": "nodemon scripts/deal-outbound-dispatch-worker.js",
    "omnichannel:poll:worker": "node scripts/omnichannel-poll-worker.js",
    "build": "echo \"Serverless build\"",
    "seed": "node seed.js",
    "smoke:openclaw": "node scripts/smoke-openclaw.js",
    "smoke:telegram": "node scripts/smoke-telegram-openclaw.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:phases-6-8": "vitest __tests__/phases-6-8.test.js",
    "seed:db": "node scripts/seedDatabase.js",
    "monitor:prod": "node scripts/monitor-production.js",
    "deploy:verify": "bash scripts/deploy-verify.sh"
  },
  "dependencies": {
    "@sentry/node": "^7.100.0",
    "@sentry/tracing": "^7.100.0",
    "@solana/web3.js": "^1.98.4",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "chromadb": "^3.0.14",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "depd": "^2.0.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^7.5.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.2",
    "redis": "^5.11.0",
    "serverless-http": "^3.2.0",
    "slugify": "^1.6.6",
    "stripe": "^14.10.0",
    "uuid": "^8.3.2",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "blockchain",
    "nft",
    "marketplace",
    "artisan"
  ],
  "author": "PVA Bazaar",
  "license": "MIT"
}
