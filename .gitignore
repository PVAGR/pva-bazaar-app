# Secrets and environment files (but allow production config)
.env
.env.local
.env.development
.env.test
*/.env
*/.env.local
.vercel/*.env*
.vercel/*.local
# ALLOW .env.production - it only contains non-secret API URLs
!Frontend/.env.production

# Node modules and logs (keep minimal)
node_modules/
npm-debug.log*
yarn-error.log*
node_modules

.env

# TypeScript build info (ignore build metadata to reduce noise)
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs and Storybook build output
*.log
storybook-static
.vercel
pva-bazaar-app.env

# Ignore most env files anywhere in the repo
**/.env
**/.env.local
.env*.local
/Frontend/archive.html
/Frontend/private/

# Documentation artifacts generated during dev/analysis
*_PACK.txt
*_PACK.md
*SUMMARY*.md
*magnum-opus-organized.html
Frontend/dist/
# HeelKawn APK — bundled at deploy time from GitHub release (see deploy-frontend.yml)
Frontend/public/downloads/*.apk

# Local temporary workspace artifacts
.tmp/
backend/data/book-projects.json

# Vercel CLI exports and Render bulk-import bundles (secrets)
.tmp-vercel*/
render-dashboard.env
.render/
render-api-key.local

# OpenClaw watchdog logs
infra/openclaw/logs/

# Nested repository duplicate (do not commit)
/pva-bazaar-app/
