# PVA Bazaar — Environment Variables (documented)
# Copy to .env.local for local dev. For Vercel: set in Project → Settings → Environment Variables.
# NEVER commit .env or .env.local with real values.

# ============ Database ============
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ============ Authentication ============
JWT_SECRET=your_jwt_secret_here

# ============ Stripe ============
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============ Site Config ============
PUBLIC_SITE_URL=https://pvabazaar.org
NODE_ENV=production

# ============ Admin ============
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_SECRET_CODE=your_secret_code
ADMIN_GITHUB_CLIENT_ID=your_github_oauth_client_id
ADMIN_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Optional: explicit callback if backend runs behind a different domain
# ADMIN_GITHUB_CALLBACK_URL=https://api.yourdomain.com/api/admin/oauth/github/callback
# Optional: where callback redirects after auth (default: PUBLIC_SITE_URL/#/admin)
# ADMIN_GITHUB_FRONTEND_URL=https://pvabazaar.org/#/admin
# Optional: comma-separated allowlist (github login, email, or github numeric id)
# ADMIN_GITHUB_ALLOWED_USERS=yourgithublogin,you@example.com,1234567
ALLOWED_ORIGIN=https://pvabazaar.org

# ============ Blockchain ============
ETHEREUM_RPC_URL=https://mainnet.base.org

# ============ Optional ============
# SMTP (fulfillment + payment-failed emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Verification API (CI → badge)
# VERIFY_API_URL=https://your-api.com
# VERIFY_API_SECRET=

# Frontend (Vite) — set in Frontend/.env.development or Vercel
# VITE_API_URL=http://localhost:5001/api
# HeelKawn links
VITE_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
VITE_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
VITE_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1
NEXT_PUBLIC_HEELKAWN_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_PC_DOWNLOAD_URL=https://github.com/PVAGR/HeelKawn1/releases/latest
NEXT_PUBLIC_HEELKAWN_REPO_URL=https://github.com/PVAGR/HeelKawn1
